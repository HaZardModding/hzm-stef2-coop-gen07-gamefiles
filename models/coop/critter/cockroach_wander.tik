TIKI
setup
{
	scale 0.25
	fade_dist_mod 250
	lod 200 1.0 6000 .2 6144
	radius 5

	path models/char/solan3/bug-small
	skelmodel small-bug-base.skb

	surface material1 shader weapons/empty
	surface material2 shader weapons/empty
	loadallanims
}

init
{
	server
		{
		classname Actor
		archetype "Cockroach"
		flags "+notarget"
		noshadow
		setsize "-6 -6 0" "6 6 2"
		health 5
		painthreshold 1
		fov 360
		actortype "enemy"
		deathshrink
		contents +shootable
		statemap ai/coop/cockroach/wander.st
		name "Cockroach"
		
		//AttachModels
		//attachmodel char/hazardteam_monocle.tik tag_head 1 None 0 -1 0 -1 0 "-3.5 0 4" "0 0 180"
		//attachmodel( String modelname, String tagname, [ Float scale ]
		//[ String targetname ], [ Boolean detach_at_death ], [ Float removetime ], [ Float fadeintime ], [ Float fadeoutdelay ], [ Float fadetime ]
		//[ Vector offset ], [ Vector angles_offset ] )
		attachmodel models/coop/critter/cockroach.tik origin 2 NoRmAl 0 -1 0 -1 0 "-4 4 0" "0 90 90"
		surface material1 shader +nodraw
		surface material2 shader +nodraw
		setactorflag "cannotdisintegrate" 1
		setactorflag "cannotfreeze" 1
		surface all flags nocustomshader
		ignorewater 0
		touchtriggers 0	
		}
	client
		{
		aliascache snd_attack1 sound/chars/bugsmall/bug_attack1.wav
		//aliascache snd_attack2 sound/chars/bugsmall/bug_attack2.wav
		//aliascache snd_attack3 sound/chars/bugsmall/bug_attack3.wav
		aliascache snd_death1 sound/chars/bugsmall/bug_death1.wav
		//aliascache snd_death2 sound/chars/bugsmall/bug_death2.wav
		}
}

animations
{
walk	walk.ska
	{
	client
		{
		//0 loopsound sound/chars/bugsmall/bug_runloop.wav 1.3 100
		}
	}

walk2	walk2.ska
	{
	client
		{
		//0 loopsound sound/chars/bugsmall/bug_runloop.wav 1.3 100
		}
	}

backpedal	backpedal.ska
	{
	client
		{
		//0 loopsound sound/chars/bugsmall/bug_runloop.wav 1.3 100
		}
	}

attack1	attack1.ska
	{
	server
		{
		3 melee 5 "origin" "alien_melee" "60 128 96" 0
		}
	client
		{
		0 sound snd_attack 1 1.3 100 .9 1.3
		}
	}

attack2	attack2.ska
	{
	server
		{
		2 melee 5 "origin" "alien_melee" "60 128 96" 0
		}
	client
		{
		0 sound snd_attack 1 1.3 100 .9 1.3
		}
	}

death1	death1.ska
	{
	
	server
		{
		0 killattach
		0 attachmodel models/coop/critter/cockroach_dead.tik origin 2 None 0 -1 0 -1 0 "-4 4 0" "0 90 90"
		}
	
	client
		{
		0 sound snd_death 1 1.3 100 .9 1.3
		
		0 originspawn
			(
			count 12 //20
			model bugblood-mist1.spr
			color 0.925 0.48 0.11
			randvel crandom 20 crandom 20 randomrange 5 25
			angles 0 0 crandom 180
			avelocity 0 0 crandom 60
			accel 0 0 -100
			life 0.65
			scale 0.15
			scalerate 0.5
			offset crandom 15 crandom 15 randomrange 9 25
			dofade 0.1 0 0
			)

		0 originspawn
			(
			count 25 //25
			model models/fx/fx-bugblood-orange1.tik models/fx/fx-bugblood-orange2.tik
			align
			randvel crandomrange 100 200 crandomrange 100 200 randomrange 77 180
			accel 0 0 -800
			life 0.375
			scale 0.2
			scalerate -1.0
			offset crandom 4 crandom 4 randomrange 14 20
			dofade 0.1 0 0
			)
			
		0 originspawn
			(
			model yellowdrop.spr
			offset crandom 8 crandom 8 10
			randvel 0 0 -700
			color 0.925 0.48 0.11
			life 0.4
			scale 0.01
			collision
			orientation random
			bouncedecal 1 0
			decalshader bugblood-splat1
			decalradius 15
			fade
			)
			
		0 originspawn
			(
			model yellowdrop.spr
			offset crandom 8 crandom 8 10
			randvel 0 0 -700
			color 0.925 0.48 0.11
			life 0.4
			scale 0.01
			collision
			orientation random
			bouncedecal 1 0
			decalshader bugblood-splat1
			decalradius 15
			fade
			)
		}
	}

fall	fall.ska
	{
	server
		{
		every melee 2 "origin" "alien_melee" "60 128 96" 0
		}
	client
		{
		0 sound snd_attack 1 1.3 100 .9 1.3
		}
	}

pre-jump-attack	pre-jump-attack.ska

jump	jump.ska
	{
	server
		{
		every melee 2 "origin" "alien_melee" "60 128 96" 0
		}
	client
		{
		0 sound snd_attack 1 1.3 100 1.5 1.8
		}
	}

land	land.ska
	{
	server
		{
		every melee 2 "origin" "alien_melee" "60 128 96" 0
		}
	client
		{
		0 sound snd_attack 1 1.3 100 1.5 1.8
		}
	}

idle	attack1.ska
	{
	client
		{
		//0 sound snd_attack 1 1.3 100 1.5 1.8
		}
	}

wanderwalk walk.ska
	{
	client
		{
		//0 loopsound sound/chars/bugsmall/bug_runloop.wav 1.3 100
		}
	}
}

/*QUAKED coop_char_critter_cockroach (0.5 0.25 0.25) (-2 -4 -1) (2 4 3)
Aimlessly wandering 2-Dimensional cockroach neutral actor

- Does not attack
- Will die if stepped on
- Will die if shot at
