menu "test_radiobutton" 640 480 NONE 0
bgcolor 0 0 0 0.75
borderstyle NONE
depth 0.2
//radobutton test menu

resource
RadioButton
{
	rect 0 0 80 22
	fgcolor 0.937 0.643 0.129 0.850
	bgcolor 1.000 0.000 0.000 0.850
    bindcvar test
    buttonsize 50 20
    padding -12 0
    radiobutton returnstring label1
    rowheight 22
	buttonshader "co-op/active"
    selectshader "co-op/cleared"
}
