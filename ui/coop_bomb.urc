menu "coop_bomb" 256 80 NONE 1
bgcolor 0 0 0 0
align left top
direction from_top 0.2
depth 0.3
gamefocus
hideDuringLoad

hidecommand	"ui_removehud coop_bomb\n"

resource 
widget
{
	name "coop_bombImg"
    rect 0 22 96 48
    fgcolor 			0.80 0.20 0.20 0.00
    bgcolor 			0.00 0.00 0.00 0.00
    borderstyle "NONE"
	shader sysimg/hud/coop_14.tga
}

resource 
Label
{
    name "coop_bombAmount"
    title "1 x"
	rect 0 -2 254 30
	fgcolor				1 1 1 1
    bgcolor 			0 0 0 0
    borderstyle "NONE"
    
   	font serpentinemedium-10
	horizontaljustify left
	verticaljustify top
	textshadowcolor 0 0 0 1
	hovertextshadowcolor 0 0 0 1
}

resource 
Label
{
    name "coop_bombTitle"
    title "Idryll Bomb"
	rect 25 -2 254 30
	fgcolor				1 1 1 1
    bgcolor 			0 0 0 0
    borderstyle "NONE"
    
   	font serpentinemedium-10
	horizontaljustify left
	verticaljustify top
	textshadowcolor 0 0 0 1
	hovertextshadowcolor 0 0 0 1
}
end.

