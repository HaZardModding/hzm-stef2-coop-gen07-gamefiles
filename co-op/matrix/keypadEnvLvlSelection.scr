void keypadEnvLvlSelection_start();
void keypadEnvLvlSelection_runThread(entity eActivator, string sThread);
float keypadEnvLvlSelection_validEntity(entity eTarget, string sBaseName);
void keypadEnvLvlSelection_clear(entity eTrigger, string sBaseName, string sText);
void keypadEnvLvlSelection_abbort(entity eTrigger, entity ePlayer, string sBaseName);
void keypadEnvLvlSelection_manage(entity eTrigger, entity ePlayer);
void keypadEnvLvlSelection_addMap(string sNumber, string sMapname, string sDescr);


void keypadEnvLvlSelection_addMap(string sNumber, string sMapname, string sDescr)
{
	$world.setStringVar("lvl_"+sNumber,sMapname);
	$world.setStringVar("lvl_"+sNumber+"_descr",sDescr);
}

void keypadEnvLvlSelection_updateHud()
{
	string sMapImg;
	string sCode;
	float iYesVotes;
	float iMaxClients;
	iMaxClients = getCvarInt("sv_maxclients");
	
	sCode = "8080";

	entity ePlayer;
	float fPlayerIdInUse;
	for(fPlayerIdInUse=0;fPlayerIdInUse<iMaxClients;fPlayerIdInUse++){
		ePlayer = getEntity("*"+fPlayerIdInUse);
		if(doesEntityExist(ePlayer)){
			sendClientCommand(ePlayer,"ui_removeHud coop_lvlSelection");
			sendClientCommand(ePlayer,"globalwidgetcommand coop_lvlSelectionImg shader "+sMapImg);
			sendClientCommand(ePlayer,"globalwidgetcommand coop_lvlSelectionCode title "+sCode);
			sendClientCommand(ePlayer,"globalwidgetcommand coop_lvlSelectionYes title "+iYesVotes);
			sendClientCommand(ePlayer,"globalwidgetcommand coop_lvlSelectionTimer title 123");
			sendClientCommand(ePlayer,"globalwidgetcommand coop_lvlSelectionName title LVLNAme");
			sendClientCommand(ePlayer,"globalwidgetcommand coop_lvlSelectionDescr title Deskr");
			sendClientCommand(ePlayer,"ui_addHud coop_lvlSelection");
		}	
	}
}


//REUSED KEYPAD code

//this gets started by a trigger, recommended: trigger_multiple with Key:wait Value:1
//The trigger has the nessary variables set
//
//targetname should contain the trigger base name, like: keypad1_trigger
//uservar1	sets the basename: keypad1
//uservar2	sets the code, max 6 digits, only numeric 0-9
//uservar3	sets script thread to run if solved: keypad1_solved
//uservar4	sets how many tries are allowed before the keypad stops working
//thread	needs to be: keypadEnvLvlSelection_start
//
//Fixed setup:
//- Failurethread after X(uservar4) tries is always: basename+_failure, in example script that is: keypad1_failure
//- the level script you want to use this with needs to include this script: #include "co-op/matrix/keypadEnv.scr"
//- All the script_object parts start need sto start with the basename, in the example that will be: keypad1_ - keypad1_1 for key number1
//- A keypad consits of about 31 script_objects and 1 detailed brush group
//- example level: coop_test-keypadEnv
void keypadEnvLvlSelection_start()
{
	entity eTrigger;
	eTrigger = getCurrentEntity();
	if(!doesEntityExist(eTrigger)){
		return;
	}
	
	//disable input
	eTrigger.notTriggerable();
	eTrigger.setFloatVar("keypadEnvCodepos",1);
	eTrigger.setFloatVar("keypadEnvSolved",0);
	
	//prevent issues with getCurrentEntity out of range
	eTrigger = eTrigger;
	
	vector vTrigger;
	vector vPlayer;
	vTrigger = eTrigger.getOrigin();
	
	entity ePlayer;
	ePlayer = eTrigger.getLastActivatingEntity();
	if(doesEntityExist(ePlayer)){
		keypadEnvLvlSelection_manage(eTrigger, ePlayer);
	}
	
	if(!doesEntityExist(eTrigger)){
		return;
	}
	
	//if(eTrigger.getFloatVar("keypadEnvSolved")){
		//return;
	//}
	if(eTrigger.getFloatVar("keypadEnvFailed")){
		return;
	}
	
	eTrigger.triggerable();
}

void keypadEnvLvlSelection_runThread(entity eActivator, string sThread)
//start thread, if possible also give Entity who activated it
{
	if(sThread == ""){
		return;
	}
	
	entity eTrigger;
	eTrigger = spawn("trigger_relay","thread",sThread,"cnt","1");
	wait(0.05);
	if(doesEntityExist(eTrigger)){
		if(doesEntityExist(eActivator)){
			eTrigger.doActivate(eActivator);
			return;
		}

		triggerEntity(eTrigger);
	}
}

float keypadEnvLvlSelection_validEntity(entity eTarget, string sBaseName)
{
	if(!doesEntityExist(eTarget)){
		return 0;
	}
	if(sBaseName == ""){
		return 0;
	}
	
	string sTargetName;
	sTargetName = eTarget.getRawTargetName();
	
	float iButton;
	for(iButton=0;iButton<=11;iButton++){
		if(sBaseName+"_"+iButton+"_item" == sTargetName){
			return 1;
		}
	}
	
	return 0;
}

void keypadEnvLvlSelection_clear(entity eTrigger, string sBaseName, string sText)
{
	if(!doesEntityExist(eTrigger)){
		return;
	}
	if(sBaseName == ""){
		return;
	}
	
	//show all input buttons
	entity eButton;
	float iButton;
	for(iButton=0;iButton<=11;iButton++){
		eButton = getEntity(sBaseName+"_"+iButton+"_item");
		if(doesEntityExist(eButton)){
			eButton.show();
		}
	}
	//hide entered digit symbol
	for(iButton=12;iButton<=17;iButton++){
		eButton = getEntity(sBaseName+"_"+iButton+"_item");
		if(doesEntityExist(eButton)){
			eButton.hide();
		}
	}
	
	entity eText;
	entity eReady;
	eReady = getEntity(sBaseName+"_ready");
	eText = getEntity(sBaseName+"_"+sText);
	if(doesEntityExist(eText)){
		if(doesEntityExist(eReady)){
			eText.warp(eReady.getOrigin());
		}
		eText.show();
	}
	
	//show entered digit empty symbol
	for(iButton=1;iButton<=6;iButton++){
		eButton = getEntity(sBaseName+"_"+iButton+"_pos");
		if(doesEntityExist(eButton)){
			eButton.hide();
		}
	}	

	//solved or failed
	if(eTrigger.getFloatVar("keypadEnvSolved") == 1 || eTrigger.getFloatVar("keypadEnvFailed") == 1){
		entity eMarker;
		eMarker = getEntity(sBaseName+"_marker");
		if(doesEntityExist(eMarker)){
			eMarker.hide();
		}
		return;
	}
	
	wait(0.25);
	
	eTrigger.setFloatVar("keypadEnvCodepos",1);
	if(doesEntityExist(eText)){
		if(doesEntityExist(eReady)){
			eText.warp(eReady.getOrigin());
			eReady.show();
		}
		eText.hide();
		
	}

	wait(0.25);
	
	//show entered digit empty symbol
	for(iButton=1;iButton<=6;iButton++){
		eButton = getEntity(sBaseName+"_"+iButton+"_pos");
		if(doesEntityExist(eButton)){
			eButton.show();
		}
	}	
	
	if(doesEntityExist(eReady)){
		eReady.hide();
	}
}

void keypadEnvLvlSelection_abbort(entity eTrigger, entity ePlayer, string sBaseName)
{
	if(doesEntityExist(ePlayer)){
		ePlayer.safeholster(0);
		ePlayer.disableuseweapon(0);
	}
	
	if(!doesEntityExist(eTrigger)){
		print("keypadEnvLvlSelection_abbort: eTrigger missing\n");
		return;
	}

	entity eMarker;
	eMarker = getEntity(sBaseName+"_marker");
	
	if(doesEntityExist(eMarker)){
		eMarker.hide();
	}
	
	keypadEnvLvlSelection_clear(eTrigger,sBaseName,"error");
	eTrigger.triggerable();
}


void keypadEnvLvlSelection_manage(entity eTrigger, entity ePlayer)
{
	string sBaseName;
	string sCode;
	string sThread;
	if(!doesEntityExist(eTrigger)){
		print("keypadEnvLvlSelection_manage: eTrigger missing\n");
		return;
	}
	if(!doesEntityExist(ePlayer)){
		print("keypadEnvLvlSelection_manage: ePlayer missing\n");
		return;
	}
	sBaseName = eTrigger.getStringvar("uservar1");
	if(sBaseName == ""){
		print("keypadEnvLvlSelection_manage: uservar1 for baseName is empty\n");
		return;
	}	
	sCode = eTrigger.getStringvar("uservar2");
	if(sCode == ""){
		print("keypadEnvLvlSelection_manage: uservar2 for code is empty\n");
		return;
	}
	sThread = eTrigger.getStringvar("uservar3");
	if(sThread == ""){
		print("keypadEnvLvlSelection_manage: uservar3 for thread is empty\n");
		return;
	}
	
	entity eMarker;
	entity eMarkerSelected;
	entity eCodePos;
	float bMarkerVisible;
	vector vTrigger;
	vector vPlayer;
	float bCleared;
	string sInputChain;
	entity eEntered;
	entity eTarget;
	float iCodePos;
	entity eReady;
	string sText;
	float iFailures;
	float iMaxFailure;
	
	iMaxFailure		= eTrigger.getFloatVar("uservar4");
	eReady			= getEntity(sBaseName+"_ready");
	eMarker			= getEntity(sBaseName+"_marker");
	eMarkerSelected = getEntity(sBaseName+"_markerSelected");
	vTrigger		= eTrigger.getOrigin();
	
	if(doesEntityExist(eReady)){
		eReady.hide();
	}
	
	if(doesEntityExist(eMarker)){
		eMarker.notsolid();
	}
	if(doesEntityExist(eMarkerSelected)){
		eMarkerSelected.notsolid();
	}
	
	//ePlayer.disableinventory(1);
	ePlayer.safeholster(1);
	ePlayer.disableuseweapon(1);
	
	string sLevel;
	string sDescr;
	
	while(1){
		if(!doesEntityExist(eTrigger)){
			return;
		}
		
		if(!doesEntityExist(ePlayer)){
			keypadEnvLvlSelection_abbort(eTrigger, $null, sBaseName);
			return;
		}
		
		if(ePlayer.getHealth() <= 0 || ePlayer.coop_isSpectator() == 1){
			keypadEnvLvlSelection_abbort(eTrigger, ePlayer, sBaseName);
			return;
		}
		
		vPlayer = ePlayer.getOrigin();
		if(vectorLength(vTrigger - vPlayer) > 64){
			keypadEnvLvlSelection_abbort(eTrigger, ePlayer, sBaseName);
			return;
		}
		
		sLevel = "";
		sDescr = "";
		
		eTarget = ePlayer.coop_getTargetedEntity();
		if(doesEntityExist(eTarget)){
			if(doesEntityExist(eMarker)){
				if(eTarget.getRawTargetName() == "world"){
					eMarker.hide();
					bMarkerVisible = 0;
					wait(0.1);
				}
				else if (keypadEnvLvlSelection_validEntity(eTarget,sBaseName)){			
					eMarker.warp(eTarget.getOrigin());
					
					if(bMarkerVisible){
						if(ePlayer.coop_checkFire() == 1 || ePlayer.coop_checkUse() ){
							
							iCodePos = eTrigger.getFloatVar("keypadEnvCodepos");

							if(iCodePos > 4){
								iCodePos = 4;
							}

							
							string sInput;
							sInput = eTarget.getStringVar("uservar1");
							
							//clear code - basically abbort
							if(sInput == "C"){
								sInput = "";
								bCleared = 1;
								sInputChain = "";
								iCodePos = 0;
								keypadEnvLvlSelection_clear(eTrigger, sBaseName,"clear");
							}
							
							//accept code
							else if(sInput == "asterisk" || iCodePos == 4){
								if(sInput != "asterisk"){
									sInputChain = (sInputChain + sInput);
								}
								
								sInput = "";
								
								if(iCodePos == 4){
									sLevel = $world.getstringVar("lvl_"+sInputChain);
									sDescr = $world.getstringVar("lvl_"+sInputChain+"_descr");
									
									if(sLevel == ""){
										$player0.hudprint("ENTERED: "+sInputChain+" - INVALID CODE\n");
									}else{
										thread keypadEnvLvlSelection_updateHud();
										
										$player0.hudprint("ENTERED: "+sInputChain+":"+sLevel+":"+sDescr+"\n");
										eTrigger.setFloatVar("keypadEnvSolved",1);
									}
									sInputChain = "";
								}


/*
//check if code is correct
if(sCode == sInputChain){
sText = "ok";

thread keypadEnvLvlSelection_runThread(ePlayer,sThread);
}else{
sText = "error";

if(iMaxFailure > 0){
iFailures = eTrigger.getFloatVar("keypadEnvFailures");
iFailures++;

if(iFailures == iMaxFailure){
eTrigger.setFloatVar("keypadEnvFailed",1);
thread keypadEnvLvlSelection_runThread(ePlayer,sBaseName+"_failure");
}
}
eTrigger.setFloatVar("keypadEnvFailures",iFailures);
}
*/
								
								bCleared = 1;
								sInputChain = "";
								iCodePos = 0;
								
								if(doesEntityExist(ePlayer)){
									ePlayer.safeholster(0);
									ePlayer.disableuseweapon(0);
								}
								
								keypadEnvLvlSelection_clear(eTrigger, sBaseName, sText);
								return;
							}
							else{
								sInputChain = (sInputChain + sInput);
							}
							
							if(!bCleared){
								eMarker.hide();
								bMarkerVisible = 0;
								
								if(doesEntityExist(eMarkerSelected)){
									eMarkerSelected.warp(eTarget.getOrigin());
									eMarkerSelected.show();
									eCodePos = getEntity(sBaseName+"_"+iCodePos+"_pos");
									if(doesEntityExist(eCodePos)){
										eCodePos.hide();
										eTarget.warp(eCodePos.getOrigin());
									}
									else{
										eTarget.hide();
									}
								}
								
								wait(0.35);
								
								eEntered = getEntity(sBaseName+"_"+(11+iCodePos)+"_item");
								if(doesEntityExist(eEntered)){
									
									eEntered.warp(eTarget.getOrigin());
									eEntered.show();
								}
								
								if(doesEntityExist(eTarget)){
									if(doesEntityExist(eMarkerSelected)){
										eTarget.warp(eMarkerSelected.getOrigin());
									}
									else{
										eTarget.show();
									}
								}							
								if(doesEntityExist(eMarkerSelected)){
									eMarkerSelected.hide();
								}
								
								iCodePos++;
								eTrigger.setFloatVar("keypadEnvCodepos",iCodePos);
							}
							bCleared=0;
						}
					}
					
					if(!bMarkerVisible){
						bMarkerVisible = 1;
						eMarker.show();
					}
				}
			}
		}else{
			eMarker.hide();
			bMarkerVisible = 0;
		}
		
		wait(0.05);
	}
}
