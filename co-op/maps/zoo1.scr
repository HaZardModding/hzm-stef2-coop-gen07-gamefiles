void coop_justEntered()
{
return;
	entity ePlayer;
	ePlayer = getCurrentEntity();
	if(doesEntityExist(ePlayer)){
		ePlayer.hudprint("Entered\n");
	}
}
void coop_justSpawned()
{
return;
	entity ePlayer;
	ePlayer = getCurrentEntity();
	if(doesEntityExist(ePlayer)){
		ePlayer.hudprint("Spawned\n");
	}
}
