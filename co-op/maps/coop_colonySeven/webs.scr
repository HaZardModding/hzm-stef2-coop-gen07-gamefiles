void webs_damaged();
void webs_touched();
void webs_triggered(entity eTrigger, entity ePlayer);

void webs_damaged()
{
	entity eTrigger,eOtherTrigger,ePlayer,eWebDestroyed;
	eTrigger=getCurrentEntity();
	if(!doesEntityExist(eTrigger)){
		return;
	}
	
	//grab destroyed web and show it
	string sDestroyedWebTargetName;
	sDestroyedWebTargetName = eTrigger.getStringVar("uservar1");
	eWebDestroyed = getEntity(sDestroyedWebTargetName);
	if(doesEntityExist(eWebDestroyed)){
		float fDestroyed;
		fDestroyed = eWebDestroyed.getFloatVar("isDestroyed");
		//avoid double activation from touch trigger
		if(fDestroyed){
			return;
		}
		eWebDestroyed.setFloatVar("isDestroyed",1);
		eWebDestroyed.show();
		eWebDestroyed.playsound("sound/chars/bugsmall/bug_sleep.wav");
	}
	
	//remove touch trigger
	eOtherTrigger = getEntity(eTrigger.getRawTargetName()+"_touch");
	
	//grab player
	ePlayer = eTrigger.getLastActivatingEntity();
	
	//handle the creature
	thread webs_triggered(eTrigger, ePlayer);
}

void webs_touched()
{
	entity eTrigger,eOtherTrigger,ePlayer,eWebDestroyed;
	eTrigger=getCurrentEntity();
	if(!doesEntityExist(eTrigger)){
		return;
	}
	
	//grab player
	ePlayer = eTrigger.getLastActivatingEntity();
	
	//grab destroyed web and show it
	string sDestroyedWebTargetName;
	sDestroyedWebTargetName = eTrigger.getStringVar("uservar1");
	
	eWebDestroyed = getEntity(sDestroyedWebTargetName);
	if(doesEntityExist(eWebDestroyed)){
		float fDestroyed;
		fDestroyed = eWebDestroyed.getFloatVar("isDestroyed");
		//avoid double activation from damage trigger
		if(fDestroyed){
			return;
		}
		eWebDestroyed.setFloatVar("isDestroyed",1);
		eWebDestroyed.show();

	}
	
	if(doesEntityExist(ePlayer)){
		ePlayer.playsound("sound/chars/bugsmall/bug_sleep.wav");
		ePlayer.addhud("coop_webing");
	}
		
	//handle the creature
	thread webs_triggered(eTrigger, ePlayer);
	
	wait(3.5);
	
	if(doesEntityExist(ePlayer)){
		ePlayer.stopsound();
		ePlayer.removeHud("coop_webing");
	}
}

void webs_triggered(entity eTrigger, entity ePlayer)
{
	if(!doesEntityExist(eTrigger)){
		return;
	}
	
	string sCreature;
	entity eCreature,eNewPos;
	
	//there can be a maximum of 3 creatures on the web
	float iCreature;
	for(iCreature=2;iCreature<5;iCreature++){
		sCreature = eTrigger.getStringVar("uservar"+iCreature);
		if("" != sCreature){
			eCreature = getEntity(sCreature);
			if(doesEntityExist(eCreature)){
				string sNewPos;
				sNewPos = eCreature.getStringVar("uservar4");
				if(sNewPos != ""){
					eNewPos = getEntity(sNewPos);
					if(doesEntityExist(eNewPos)){
						eCreature.origin(eNewPos.getOrigin());
						eCreature.angles('148.000000 91.000000 1.000000');
					}
				}
				eCreature.kill();
			}
		}
	}
	
	
	return;
	entity eRemove;
	string sBaseName;
	sBaseName = eTrigger.getRawTargetName();
	eTrigger = eTrigger.getEntity(sBaseName);
	while(doesEntityExist(eTrigger)){
		eRemove = eTrigger;
		eTrigger = getNextEntity(eTrigger);
		
		if(doesEntityExist(eRemove)){
			eRemove.remove();
		}
	}
}