// Handle all that has to do with setup
//------------------------------------------------------------------------------
{
	thread setupSky();
	
	//redalert lights - turn off
	// //getlightintensity( String light_group_name )
	// //light_lightstyle( String light_group_name, String light_style, [ Boolean stop_at_end ] )
	$world.light_intensity("lights_alertRed", 0.0 ); //set to 1.0 for redalert
	
	//fullbright various models
	
	$viewscreen_deck1_bridge.rendereffects("+fullbright");
	$viewscreen_deck7_hazardOps.rendereffects("+fullbright");
	$display_deck1_observation.rendereffects("+fullbright");
